---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Img from "@/components/Media/Img.astro";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The project's title. */
  heading?: string;
  /** Who it was for. */
  client?: string;
  /** The years it ran, as shown beside the client name. */
  period?: string;
  /** Short labels under the title — a role, a deliverable, an industry. */
  tags?: string[];
  /** Colors the image panel. Shows through until `image` is set. */
  tint?: "teal" | "purple";
  /** A path in `public/` for the image panel. Left unset, `tint` shows instead. */
  image?: string;
  /**
   * - `default` — client, title and tags (default)
   * - `in-progress` — the same, with a status badge above the client line
   */
  status?: "default" | "in-progress";
  /** Where the card leads. Left unset, it renders as a plain, unlinked card. */
  href?: string;
};

const {
  render = true,
  heading,
  client,
  period,
  tags = [],
  tint = "teal",
  image,
  status = "default",
  href,
  class: className,
  ...rest
} = Astro.props as Base;

const hasContent = !!(heading || client || tags.length);
const Tag = href ? "a" : "div";
---

{
  render && hasContent && (
    <Tag
      class:list={["project-card_wrap", !href && "no-link", className]}
      href={href}
      data-project-card={href ? "" : undefined}
      data-reveal="card"
      {...rest}
    >
      <div class="project-card_content">
        {status === "in-progress" && (
          <span class="project-card_status">
            <span class="project-card_status_dot" aria-hidden="true" />
            In Progress
          </span>
        )}
        {(client || period) && (
          <p class="project-card_meta text-style-small">
            {client}
            {client && period && " / "}
            {period}
          </p>
        )}
        {heading && (
          <Heading tag="h3" variant="h4" class="project-card_heading">
            {heading}
          </Heading>
        )}
        {tags.length > 0 && (
          <ul class="project-card_tags">
            {tags.map((tag) => (
              <li class="project-card_tag">{tag}</li>
            ))}
          </ul>
        )}
      </div>
      <div class:list={["project-card_visual", !image && tint]}>
        {image && <Img src={image} alt="" class="project-card_image" />}
      </div>
    </Tag>
  )
}

<script>
  import gsap from "gsap";

  const HINT_LERP = 0.15;
  const HINT_OFFSET = 20;
  const HINT_TILT_MAX = 10;
  const HINT_TILT_DIVISOR = 25;
  const HINT_FADE_DURATION = 0.15;
  const HINT_TILT_DURATION = 0.3;
  const HINT_TILT_EASE = "power4.out";
  const HINT_RESET_EASE = "power4.in";

  const canShowHint =
    window.matchMedia("(hover: hover)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");

  if (canShowHint && cards.length) {
    // A `position: fixed` element inside a card would be clipped by the
    // card's own `overflow: clip` (any non-visible overflow makes an
    // ancestor a containing block for fixed descendants), so one shared
    // hint lives on `body` instead, moved to whichever card is hovered.
    const hint = document.createElement("span");
    hint.className = "project-card_hint";
    hint.setAttribute("aria-hidden", "true");
    hint.textContent = "Click for more";
    document.body.append(hint);

    let targetX = 0,
      targetY = 0,
      smoothX = 0,
      smoothY = 0;
    let lastX = 0,
      lastT = performance.now();
    let inside = false;
    let tiltTween: ReturnType<typeof gsap.to> | undefined;

    gsap.set(hint, { rotate: 0 });

    gsap.ticker.add(() => {
      if (!inside) return;
      smoothX += HINT_LERP * (targetX - smoothX);
      smoothY += HINT_LERP * (targetY - smoothY);
      gsap.set(hint, { x: smoothX, y: smoothY });
    });

    cards.forEach((card) => {
      card.addEventListener("mouseenter", (event) => {
        inside = true;
        targetX = smoothX = event.clientX + HINT_OFFSET;
        targetY = smoothY = event.clientY + HINT_OFFSET;
        lastX = targetX;
        lastT = performance.now();
        gsap.set(hint, { x: smoothX, y: smoothY });
        gsap.to(hint, { autoAlpha: 1, duration: HINT_FADE_DURATION });
      });

      card.addEventListener("mousemove", (event) => {
        targetX = event.clientX + HINT_OFFSET;
        targetY = event.clientY + HINT_OFFSET;
        const now = performance.now();
        const velocity = ((targetX - lastX) / (now - lastT || 16)) * 1000;
        lastX = targetX;
        lastT = now;
        const tilt = gsap.utils.clamp(
          -HINT_TILT_MAX,
          HINT_TILT_MAX,
          velocity / HINT_TILT_DIVISOR,
        );
        tiltTween?.kill();
        tiltTween = gsap.to(hint, {
          rotate: tilt,
          duration: HINT_TILT_DURATION,
          ease: HINT_TILT_EASE,
        });
      });

      card.addEventListener("mouseleave", () => {
        inside = false;
        gsap.to(hint, {
          autoAlpha: 0,
          rotate: 0,
          duration: HINT_FADE_DURATION,
          ease: HINT_RESET_EASE,
        });
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .project-card_wrap {
      --_tag-border: color-mix(in lab, var(--text) 18%, transparent);
      --_tag-text: color-mix(in lab, var(--text) 75%, transparent);
      --_meta-text: color-mix(in lab, var(--text) 55%, transparent);
      position: relative;
      display: flex;
      align-items: stretch;
      width: 100%;
      min-height: 18.75rem;
      background-color: color-mix(in lab, var(--text) 10%, transparent);
      border: var(--border-width) solid color-mix(in lab, var(--text) 14%, transparent);
      border-radius: var(--radius-main);
      overflow: clip;
      transition:
        transform var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          transform: translateY(-0.25rem);
          border-color: color-mix(in lab, var(--text) 28%, transparent);
        }
      }

      @media (width < 48rem) {
        flex-direction: column;
        min-height: 0;
      }
    }

    .project-card_content {
      display: flex;
      flex: 1 0 0;
      flex-direction: column;
      align-items: start;
      gap: var(--space-4);
      min-width: 0;
      padding: var(--space-6) var(--space-5);
    }

    .project-card_status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3) var(--space-1) var(--space-2);
      background-color: color-mix(in lab, orange 15%, transparent);
      color: orange;
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: var(--radius-round);
    }

    .project-card_status_dot {
      width: 0.4rem;
      height: 0.4rem;
      background-color: currentcolor;
      border-radius: var(--radius-round);
    }

    .project-card_meta {
      color: var(--_meta-text);
    }

    .project-card_heading {
      max-width: 22ch;
    }

    .project-card_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      list-style: none;
    }

    .project-card_tag {
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid var(--_tag-border);
      border-radius: var(--radius-round);
      font-size: 0.6875rem;
      font-weight: var(--primary-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--_tag-text);
    }

    .project-card_visual {
      position: relative;
      display: flex;
      flex: 1 0 0;
      align-items: flex-end;
      justify-content: flex-end;
      padding: var(--space-4);
      min-width: 0;
      overflow: clip;

      &.teal {
        background-color: color-mix(in lab, cyan 28%, transparent);
      }
      &.purple {
        background-color: color-mix(in lab, blueviolet 28%, transparent);
      }

      @media (width < 48rem) {
        min-height: 12rem;
        flex: none;
      }
    }

    .project-card_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .project-card_hint {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 90;
      padding: var(--space-2) var(--space-4);
      background-color: var(--brand-500);
      color: var(--brand-text);
      font-size: 0.6875rem;
      font-weight: var(--primary-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: var(--radius-round);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      will-change: transform;
    }
  }
</style>
