---
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <span class="tag_wrap text-style-small">
      <Fragment set:html={content} />
    </span>
  )
}

<style is:global>
  @layer components {
    .tag_wrap {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1) var(--space-3);
      border: var(--border-width) solid color-mix(in lab, var(--text) 18%, transparent);
      border-radius: var(--radius-round);
      font-size: 0.6875rem;
      font-weight: var(--primary-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: color-mix(in lab, var(--text) 75%, transparent);
      white-space: nowrap;
    }
  }
</style>
