---
import Marquee from "@/components/Interactive/Marquee.astro";
import { SITE_NAME } from "@/consts.ts";

const MARQUEE_REPEATS = 5;

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <footer class="footer_wrap">
      <Marquee label={SITE_NAME} controls={false} class="footer_marquee">
        {
          Array.from({ length: MARQUEE_REPEATS }).map((_, i) => (
            <Fragment>
              <span class="footer_marquee_text text-style-display" aria-hidden="true">
                ARON FRIDVALSZKY
              </span>
              {i < MARQUEE_REPEATS - 1 && (
                <span class="footer_marquee_dot" aria-hidden="true" />
              )}
            </Fragment>
          ))
        }
      </Marquee>
      <div class="footer_inner">
        <div class="footer_bottom">
          <nav class="footer_social" aria-label="Social">
            <a class="footer_link" href="#">LinkedIn</a>
            <span class="footer_social_dot" aria-hidden="true" />
            <a class="footer_link" href="#">Behance</a>
          </nav>
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      /* `--background-3` matches the light theme's white (Home ends on a
         `background-3` Contact section) — overridden below for the dark
         theme, where the page itself (a project page) never switches to
         `background-3` for its own sections, so matching it here would
         leave the footer a visibly different shade of dark instead. */
      background-color: var(--background-3);
      color: var(--text);
    }

    .theme-dark .footer_wrap {
      background-color: var(--background);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4) var(--space-6);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_social {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_link {
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_copyright {
      color: var(--text-2);
    }

    .footer_marquee {
      /* Slower than the component's own default pace. */
      --_speed: 8s;
      /* Runs to the true page edges, breaking out of footer_wrap's own
         inline padding rather than stopping at the site margin like the
         rest of the footer. */
      width: calc(100% + var(--site-margin) * 2);
      margin-inline: calc(-1 * var(--site-margin));
    }

    .footer_marquee_text {
      font-weight: var(--primary-medium);
      white-space: nowrap;
    }

    .footer_marquee_dot {
      flex: none;
      width: 0.5rem;
      height: 0.5rem;
      background-color: var(--text-2);
      border-radius: var(--radius-round);
    }

    .footer_social_dot {
      flex: none;
      width: 0.25rem;
      height: 0.25rem;
      background-color: var(--text-2);
      border-radius: var(--radius-round);
    }
  }
</style>
