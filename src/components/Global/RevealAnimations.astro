---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { SplitText } from "gsap/SplitText";

      gsap.registerPlugin(ScrollTrigger, SplitText);

      const mm = gsap.matchMedia();

      /* The conditions-object form of `mm.add()` — `mm.add({ name: query },
         callback)` — never invokes its callback as of gsap 3.15.0 (verified
         directly: the plain string-query form below fires synchronously,
         the object form silently doesn't). Using the plain form instead,
         with the query itself expressing "not reduced motion" so nothing
         here runs at all for anyone who prefers reduced motion. */
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        /* Section titles: split into characters, each rising up from below
           in a stagger. */
        const titles = gsap.utils.toArray<HTMLElement>(
          '[data-reveal="title-chars"]',
        );
        for (const title of titles) {
          const split = SplitText.create(title, {
            type: "chars",
            smartWrap: true,
          });
          gsap.from(split.chars, {
            y: 60,
            autoAlpha: 0,
            duration: 0.6,
            ease: "power3.out",
            stagger: 0.025,
            scrollTrigger: {
              trigger: title,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          });
        }

        /* Groups: each direct child staggers in, timed off the group's own
           scroll position. */
        const groups = gsap.utils.toArray<HTMLElement>(
          '[data-reveal="stagger"]',
        );
        for (const group of groups) {
          const items = Array.from(group.children) as HTMLElement[];
          if (!items.length) continue;
          gsap.from(items, {
            y: 32,
            autoAlpha: 0,
            duration: 0.7,
            ease: "power2.out",
            stagger: 0.12,
            scrollTrigger: {
              trigger: group,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          });
        }

        /* Project cards: each has its own trigger, so it reveals as it
           individually scrolls into view rather than all at once off a
           shared group position. `clearProps` drops the inline `transform`
           GSAP leaves behind once the tween settles at its rest value —
           left in place, that inline style would outrank the card's own
           CSS `:hover` lift, since inline style always beats a stylesheet
           rule regardless of specificity. */
        const cards = gsap.utils.toArray<HTMLElement>('[data-reveal="card"]');
        for (const card of cards) {
          gsap.from(card, {
            y: 32,
            autoAlpha: 0,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform",
            scrollTrigger: {
              trigger: card,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          });
        }

        /* Headlines that are already on screen at page load (the hero, a
           project page's own title) — no scroll trigger, so they play as
           soon as this script runs rather than waiting on a scroll event
           that may never come if the page opens already at the top. */
        const loadChars = gsap.utils.toArray<HTMLElement>(
          '[data-reveal="load-chars"]',
        );
        for (const el of loadChars) {
          const split = SplitText.create(el, { type: "chars", smartWrap: true });
          gsap.from(split.chars, {
            y: 60,
            autoAlpha: 0,
            duration: 0.6,
            ease: "power3.out",
            stagger: 0.025,
          });
        }

        /* Body copy that's on screen at load (a project page's paragraphs):
           same idea as `load-chars`, but split into lines — reading-length
           text reveals better as whole lines than individual letters, and
           `mask: "lines"` clips each line to its own box so it rises up
           from behind a hard edge instead of overlapping the line below. */
        const loadLines = gsap.utils.toArray<HTMLElement>(
          '[data-reveal="load-lines"]',
        );
        for (const el of loadLines) {
          const split = SplitText.create(el, { type: "lines", mask: "lines" });
          gsap.from(split.lines, {
            y: 24,
            autoAlpha: 0,
            duration: 0.7,
            ease: "power2.out",
            stagger: 0.08,
            delay: 0.15,
          });
        }

        /* About's name/role/bio: each paragraph has its own trigger, same
           "own trigger per element" approach as the project cards, so they
           read in one after another purely from their natural scroll order
           rather than one shared group timing. */
        const scrollLines = gsap.utils.toArray<HTMLElement>(
          '[data-reveal="scroll-lines"]',
        );
        for (const el of scrollLines) {
          const split = SplitText.create(el, { type: "lines", mask: "lines" });
          gsap.from(split.lines, {
            y: 24,
            autoAlpha: 0,
            duration: 0.7,
            ease: "power2.out",
            stagger: 0.08,
            scrollTrigger: {
              trigger: el,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          });
        }

        /* Parallax: an element drifts at a different rate than the page
           scroll as whatever it's scoped to (its nearest `.section` by
           default, or another element via `data-parallax-scope`) passes
           through the viewport — offset upward on the way in, downward on
           the way out, `ease: "none"` so it tracks scroll position 1:1
           rather than lagging behind it. `data-parallax` sets how far it
           travels, as a percentage of its own height (default 15); this
           only ever reads scroll progress off a plain `scrub` — nothing
           here pins anything in place, which is what made the earlier,
           much heavier attempt at richer section transitions fragile. */
        const parallaxEls = gsap.utils.toArray<HTMLElement>("[data-parallax]");
        for (const el of parallaxEls) {
          const amount = parseFloat(el.dataset.parallax || "") || 15;
          const scopeSelector = el.dataset.parallaxScope;
          const scope = scopeSelector
            ? (el.closest<HTMLElement>(scopeSelector) ?? el.closest<HTMLElement>(".section"))
            : el.closest<HTMLElement>(".section");
          gsap.fromTo(
            el,
            { yPercent: -amount },
            {
              yPercent: amount,
              ease: "none",
              scrollTrigger: {
                trigger: scope ?? el,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            },
          );
        }

        /* Darkens an outgoing stacked section (home page: hero, Work) as
           it's climbed over by the next one — `.section-stack_darken` in
           index.astro, a child *inside* the section itself via `Section`'s
           `overlay` slot, not a separate element after it. An earlier
           version used a dedicated one-viewport-tall sticky element
           between each pair of sections for this, which added a whole
           extra viewport of scroll distance nothing else used: the next
           section couldn't start climbing over anything until that
           separate element's own scroll window had run its course, so it
           read as a dead, static gap before anything moved. Scoping the
           darken to the section's own scroll range instead means Work
           already starts climbing the moment the hero begins darkening —
           no added distance, no gap.

           `data-darken-scope="self"` (the hero, exactly one viewport tall)
           darkens across its whole scroll range. `data-darken-scope="tail"`
           (Work, much taller — a heading plus every project card) darkens
           only over the last viewport of it, `"bottom bottom"` to
           `"bottom top"`, rather than the entire height, which would start
           dimming it while its cards are still being read.

           Ramps to fully opaque within the first 30% of that range and
           holds there, rather than a slow linear fade the whole way: a
           `position: sticky` section (the hero) doesn't release once its
           own height's worth of scrolling has passed the way pinning
           does — it stays eligible to render at `top: 0` indefinitely,
           just invisible once something opaque covers it, the same way
           studiors.be's own stacked cards (always instantly 100% opaque,
           never a gradual fade) work. A darken overlay that fades in
           gradually breaks that: while it's still partway to opaque,
           there's a real gap for whatever's stuck underneath to show back
           through. */
        const darkenEls = gsap.utils.toArray<HTMLElement>(".section-stack_darken");
        for (const el of darkenEls) {
          const section = el.closest<HTMLElement>(".section");
          if (!section) continue;
          const isTail = el.dataset.darkenScope === "tail";

          gsap
            .timeline({
              scrollTrigger: {
                trigger: section,
                start: isTail ? "bottom bottom" : "top top",
                end: "bottom top",
                scrub: true,
              },
            })
            .fromTo(el, { opacity: 0 }, { opacity: 1, ease: "none", duration: 0.3 })
            .to(el, { opacity: 1, duration: 0.7 });
        }
      });
    </script>
  )
}
