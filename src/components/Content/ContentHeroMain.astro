---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Said before the name, e.g. "My name is". */
  introLead?: string;
  /** The name itself. */
  name?: string;
  /** Said after the name, leading into the headline, e.g. "and". */
  introTrail?: string;
  /** The main line, e.g. "I design things". */
  headline?: string;
  /** The line under the headline. */
  subheadline?: string;
  /** Small stat blocks — a location, a focus, a stack. */
  stats?: { label: string; value: string }[];
}

const {
  render = true,
  introLead,
  name,
  introTrail,
  headline,
  subheadline,
  stats = [],
} = Astro.props;

const hasContent = !!(introLead || name || headline);
---

{
  render && hasContent && (
    <div class="hero-main_wrap">
      {(introLead || name || introTrail) && (
        <div class="hero-main_intro">
          {introLead && <p class="text-style-large">{introLead}</p>}
          {name && <p class="hero-main_name">{name}</p>}
          {introTrail && <p class="text-style-large">{introTrail}</p>}
        </div>
      )}

      <div class="hero-main_body">
        {(headline || subheadline) && (
          <div class="hero-main_headline">
            {headline && (
              <Heading tag="h1" variant="display">
                {headline}
              </Heading>
            )}
            {subheadline && <Paragraph variant="large">{subheadline}</Paragraph>}
          </div>
        )}

        {stats.length > 0 && (
          <ul class="hero-main_stats">
            {stats.map(({ label, value }) => (
              <li class="hero-main_stat">
                <p class="hero-main_stat_label text-style-small">{label}</p>
                <p class="hero-main_stat_value text-style-main">{value}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  )
}

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  /* The hero's entrance is its own bespoke, sequenced timeline rather than
     the shared load-chars/load-lines reveal types the rest of the site
     uses (see RevealAnimations.astro) — those fire independently of each
     other, but this needs a specific relative order: the intro line, then
     the headline block sliding in behind it, then the headline's own
     characters, then the subheadline a beat after that. */
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const intro = document.querySelector<HTMLElement>(".hero-main_intro");
    const headlineWrap = document.querySelector<HTMLElement>(".hero-main_headline");
    if (!intro && !headlineWrap) return;

    const heading = headlineWrap?.querySelector<HTMLElement>("h1") ?? null;
    const subheadline = headlineWrap?.querySelector<HTMLElement>("p") ?? null;

    const tl = gsap.timeline();
    const enterFromLeft = {
      x: "-20rem",
      autoAlpha: 0,
      duration: 0.9,
      ease: "power2.out",
    };

    if (intro) tl.from(intro, enterFromLeft);
    if (headlineWrap) {
      tl.from(headlineWrap, enterFromLeft, intro ? "-=0.4" : 0);
    }

    if (heading) {
      const headingSplit = SplitText.create(heading, {
        type: "chars",
        smartWrap: true,
      });
      tl.from(headingSplit.chars, {
        y: 60,
        autoAlpha: 0,
        duration: 0.6,
        ease: "power3.out",
        stagger: 0.025,
      });
    }

    if (subheadline) {
      /* Same line-reveal a project page's headline uses (`load-lines` in
         RevealAnimations.astro) — split into lines, masked so each rises up
         from behind a hard edge, timed a second after the headline's own
         reveal starts rather than the generic type's fixed 0.15s delay. */
      const subheadlineSplit = SplitText.create(subheadline, {
        type: "lines",
        mask: "lines",
      });
      tl.from(
        subheadlineSplit.lines,
        {
          y: 24,
          autoAlpha: 0,
          duration: 0.7,
          ease: "power2.out",
          stagger: 0.08,
        },
        "<1",
      );
    }
  });
</script>

<style is:global>
  @layer components {
    .hero-main_wrap {
      position: relative;
      display: flex;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-8);
      width: 100%;
      min-height: 0;
    }

    .hero-main_intro {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      row-gap: var(--space-3);
      column-gap: var(--space-3);
    }

    .hero-main_name {
      font-weight: var(--primary-medium);
      font-size: var(--h3);
    }

    .hero-main_body {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .hero-main_stats {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      list-style: none;
    }

    .hero-main_stat {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      /* Equal grow + basis, not just a shared minimum — so both stay the
         same width as each other however long either one's value text
         gets, wrapping it instead of letting the box stretch to fit. Capped
         with the same fluid clamp() shape the rest of the site's tokens
         use, just kept local here rather than added to base.css — nothing
         else needs this exact width. */
      --_meta-width-min: 192;
      --_meta-width-max: 300;
      flex: 1 1 12rem;
      max-width: clamp(
        var(--_meta-width-min) / 16 * 1rem,
        ((var(--_meta-width-min) - ((var(--_meta-width-max) - var(--_meta-width-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--_meta-width-max) - var(--_meta-width-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw),
        var(--_meta-width-max) / 16 * 1rem
      );
      padding: var(--space-4);
      background-color: var(--glass-background);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
      border-radius: var(--radius-main);
    }

    .hero-main_stat_label {
      color: var(--text-2);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .hero-main_stat_value {
      font-weight: var(--primary-medium);
    }
  }
</style>
