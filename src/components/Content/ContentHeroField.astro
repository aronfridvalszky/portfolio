---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div
      class="hero-main_scene"
      aria-hidden="true"
      data-fluid-color-1="#fcd9e5"
      data-fluid-color-2="#fce4cf"
      data-fluid-color-3="#fcf3cf"
      data-fluid-color-4="#c9f7ec"
      data-fluid-color-5="#d0e7fb"
      data-fluid-color-6="#eadcf9"
    />
  )
}

<script>
  import * as THREE from "three";
  import { vertexShader, fluidShader, displayShader, asColorLinear } from "@/utils/fluidShaders.ts";

  /* A real-time WebGL fluid simulation (three.js) — a ping-pong
     fluid-velocity sim feeding a distorted, ever-shifting 6-colour
     gradient. Rewritten from first principles for this scene, not a copy of
     any third-party embed. The shader source itself lives in
     `@/utils/fluidShaders.ts`, kept separate from this component's own
     render-loop and pointer-tracking logic.

     Two things kept different from a typical drop-in version, both because
     this sits behind clickable hero content rather than filling the
     viewport on its own: pointer tracking listens on `window`, not the
     canvas, since the canvas has `pointer-events: none` so nav and hero
     links underneath stay clickable; and sizing follows this element's own
     box, not the window's. */

  function initFluidField() {
    const root = document.querySelector<HTMLElement>(".hero-main_scene");
    if (!root) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isFinePointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;

    const config = {
      brushSize: 25.0,
      brushStrength: 0.5,
      distortionAmount: 2.5,
      fluidDecay: 0.98,
      trailLength: 0.8,
      stopDecay: 0.85,
      color1: root.dataset.fluidColor1 || "#fcd9e5",
      color2: root.dataset.fluidColor2 || "#fce4cf",
      color3: root.dataset.fluidColor3 || "#fcf3cf",
      color4: root.dataset.fluidColor4 || "#c9f7ec",
      color5: root.dataset.fluidColor5 || "#d0e7fb",
      color6: root.dataset.fluidColor6 || "#eadcf9",
      colorIntensity: 1.0,
      softness: 0.4,
      dprMax: 2.0,
      flowSpeed: 1.0,
      idleSpeed: reducedMotion ? 0 : 0.5,
    };

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.NoToneMapping;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, config.dprMax));
    root.appendChild(renderer.domElement);
    renderer.domElement.classList.add("hero-main_fluid-canvas");

    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const getSize = () => {
      const r = root.getBoundingClientRect();
      return { width: Math.max(1, r.width), height: Math.max(1, r.height) };
    };

    const rtOptions = {
      minFilter: THREE.LinearFilter,
      magFilter: THREE.LinearFilter,
      format: THREE.RGBAFormat,
      type: THREE.HalfFloatType,
      depthBuffer: false,
      stencilBuffer: false,
    };
    const fluidTarget1 = new THREE.WebGLRenderTarget(1, 1, rtOptions);
    const fluidTarget2 = fluidTarget1.clone();
    let currentFluidTarget = fluidTarget1;
    let previousFluidTarget = fluidTarget2;

    const fluidMaterial = new THREE.ShaderMaterial({
      uniforms: {
        iTime: { value: 0 },
        iResolution: { value: new THREE.Vector2(1, 1) },
        iMouse: { value: new THREE.Vector4(0, 0, 0, 0) },
        iFrame: { value: 0 },
        iPreviousFrame: { value: null },
        uBrushSize: { value: config.brushSize },
        uBrushStrength: { value: config.brushStrength },
        uFluidDecay: { value: config.fluidDecay },
        uTrailLength: { value: config.trailLength },
        uStopDecay: { value: config.stopDecay },
        uSoftReset: { value: 0.0 },
        uFlowSpeed: { value: config.flowSpeed },
      },
      vertexShader,
      fragmentShader: fluidShader,
    });

    const displayMaterial = new THREE.ShaderMaterial({
      uniforms: {
        iTime: { value: 0 },
        iResolution: { value: new THREE.Vector2(1, 1) },
        iFluid: { value: null },
        uDistortionAmount: { value: config.distortionAmount },
        uColor1: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color1)) },
        uColor2: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color2)) },
        uColor3: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color3)) },
        uColor4: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color4)) },
        uColor5: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color5)) },
        uColor6: { value: new THREE.Vector3(...asColorLinear(THREE.Color, config.color6)) },
        uColorIntensity: { value: config.colorIntensity },
        uSoftness: { value: config.softness },
        uIdleSpeed: { value: config.idleSpeed },
      },
      vertexShader,
      fragmentShader: displayShader,
      toneMapped: false,
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const fluidPlane = new THREE.Mesh(geometry, fluidMaterial);
    const displayPlane = new THREE.Mesh(geometry, displayMaterial);

    function setSize() {
      const { width, height } = getSize();
      renderer.setSize(width, height);
      fluidMaterial.uniforms.iResolution.value.set(width, height);
      displayMaterial.uniforms.iResolution.value.set(width, height);
      fluidTarget1.setSize(width, height);
      fluidTarget2.setSize(width, height);
    }
    setSize();

    let mouseX = 0,
      mouseY = 0,
      prevMouseX = 0,
      prevMouseY = 0,
      lastMoveTime = 0;

    if (isFinePointer && !reducedMotion) {
      window.addEventListener(
        "mousemove",
        (event) => {
          const rect = root.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = rect.height - (event.clientY - rect.top);
          prevMouseX = mouseX;
          prevMouseY = mouseY;
          mouseX = x;
          mouseY = y;
          lastMoveTime = performance.now();
          fluidMaterial.uniforms.iMouse.value.set(mouseX, mouseY, prevMouseX, prevMouseY);
        },
        { passive: true },
      );
      document.addEventListener(
        "mouseleave",
        () => {
          fluidMaterial.uniforms.iMouse.value.set(0, 0, 0, 0);
        },
        { passive: true },
      );
    }

    let frameCount = 0;

    function renderFrame(time: number) {
      fluidMaterial.uniforms.iTime.value = time;
      displayMaterial.uniforms.iTime.value = time;
      fluidMaterial.uniforms.iFrame.value = frameCount;

      if (performance.now() - lastMoveTime > 120) {
        fluidMaterial.uniforms.iMouse.value.set(0, 0, 0, 0);
      }

      fluidMaterial.uniforms.iPreviousFrame.value = previousFluidTarget.texture;
      renderer.setRenderTarget(currentFluidTarget);
      renderer.render(fluidPlane, camera);

      displayMaterial.uniforms.iFluid.value = currentFluidTarget.texture;
      renderer.setRenderTarget(null);
      renderer.render(displayPlane, camera);

      [currentFluidTarget, previousFluidTarget] = [previousFluidTarget, currentFluidTarget];
      frameCount++;
    }

    function animate() {
      renderFrame(performance.now() * 0.001);
      requestAnimationFrame(animate);
    }

    if (reducedMotion) {
      /* A few still frames — the fluid sim needs to settle out of its seed
         pattern before it reads as a normal gradient. */
      for (let i = 0; i < 3; i++) renderFrame(0);
    } else {
      requestAnimationFrame(animate);
    }

    let resizeRaf = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(setSize);
    });
  }

  initFluidField();
</script>

<style is:global>
  @layer components {
    .hero-main_scene {
      position: absolute;
      inset: 0;
      overflow: clip;
      pointer-events: none;
    }

    .hero-main_fluid-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>
