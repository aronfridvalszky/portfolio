---
import type { SvgComponent } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Img from "@/components/Media/Img.astro";
import Icon from "@/components/Media/Icon.astro";

type ImageSource = ImageMetadata | string;

interface Tool {
  name: string;
  /** The tool's own logo, imported from `src/assets`. */
  icon: SvgComponent;
}

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. Left unset, a placeholder shows instead. */
  portrait?: ImageSource;
  name?: string;
  role?: string;
  /** Bio, one paragraph per array entry. */
  bio?: string[];
  services?: string[];
  tools?: Tool[];
}

const {
  render = true,
  portrait,
  name,
  role,
  bio = [],
  services = [],
  tools = [],
} = Astro.props;

const hasContent = !!(name || bio.length || services.length || tools.length);
---

{
  render && hasContent && (
    <div class="about-main_wrap">
      <div class="about-main_profile">
        <div class="about-main_portrait">
          {portrait ? (
            <Img src={portrait} alt="" />
          ) : (
            <div class="about-main_portrait_placeholder" aria-hidden="true" />
          )}
        </div>
        {(name || role) && (
          <div class="about-main_name-row">
            {name && (
              <Heading tag="h2" variant="h2" data-reveal="title-chars">
                {name}
              </Heading>
            )}
            {role && (
              <Paragraph variant="large" data-reveal="scroll-lines">
                {role}
              </Paragraph>
            )}
          </div>
        )}
      </div>

      <div class="about-main_rows">
        {bio.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Bio</p>
            <div class="about-main_row_content">
              {bio.map((paragraph) => (
                <Paragraph variant="main" data-reveal="scroll-lines">
                  {paragraph}
                </Paragraph>
              ))}
            </div>
          </div>
        )}
        {services.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Services</p>
            <ul class="about-main_list">
              {services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
        )}
        {tools.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Tools I use</p>
            <ul class="about-main_tools" data-reveal="stagger">
              {tools.map(({ name: toolName, icon }) => (
                <li class="about-main_tool">
                  <span class="about-main_tool_mark">
                    <Icon src={icon} variant="full-width" />
                  </span>
                  <span class="text-style-small">{toolName}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .about-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      width: 100%;
    }

    .about-main_profile {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--space-6);
    }

    .about-main_portrait {
      position: relative;
      flex: 1 1 20rem;
      max-width: 30rem;
      aspect-ratio: 5 / 4;
      border-radius: var(--radius-main);
      overflow: clip;

      /* The source photo is only cropped left/right by a plain `cover` fit
         here (it's wider, proportionally, than this box) — the `img` itself
         wasn't stretched to the box before (no `height: 100%`), so `cover`
         had nothing to crop against and the photo just sat at its own
         intrinsic ratio, leaving a gap at the bottom. `scale` + `translateY`
         zoom in past that base crop and re-center lower in the frame. */
      & img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.4) translateY(10%);
        transform-origin: center;
      }
    }

    .about-main_portrait_placeholder {
      width: 100%;
      height: 100%;
      background-color: var(--background-skeleton);
    }

    .about-main_name-row {
      flex: 1 1 16rem;
    }

    .about-main_rows {
      display: flex;
      flex-direction: column;
    }

    .about-main_row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-6);
      padding-block: var(--space-6);
      border-top: var(--border-width) solid var(--border);
    }

    .about-main_row_label {
      flex: 0 0 10rem;
      font-weight: var(--primary-medium);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .about-main_row_content {
      flex: 1 1 30rem;
      max-width: 48rem;
      display: flex;
      flex-direction: column;
    }

    .about-main_list {
      flex: 1 1 30rem;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      list-style: none;
    }

    .about-main_tools {
      flex: 1 1 30rem;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      list-style: none;
    }

    .about-main_tool {
      /* Fixed to "Claude Code"'s own width — the longest label — so every
         card matches it instead of shrinking to its own text. */
      flex: 0 0 7.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-3);
      text-align: center;
      background-color: var(--glass-background);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
      border-radius: 1rem;
    }

    .about-main_tool_mark {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3.5rem;
      height: 3.5rem;

      /* Each logo keeps its own real colours and proportions — a Webflow
         wordmark and a square app icon aren't the same shape — so what
         makes the row read as "one set" is the shared glass card on
         `.about-main_tool` now, not a forced single style per mark. */
      & .icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }
  }
</style>
