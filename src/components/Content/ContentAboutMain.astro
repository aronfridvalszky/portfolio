---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Img from "@/components/Media/Img.astro";

type ImageSource = ImageMetadata | string;

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. Left unset, a placeholder shows instead. */
  portrait?: ImageSource;
  name?: string;
  role?: string;
  /** Bio, one paragraph per array entry. */
  bio?: string[];
  services?: string[];
  tools?: string[];
}

const {
  render = true,
  portrait,
  name,
  role,
  bio = [],
  services = [],
  tools = [],
} = Astro.props;

const hasContent = !!(name || bio.length || services.length || tools.length);
---

{
  render && hasContent && (
    <div class="about-main_wrap">
      <div class="about-main_profile">
        <div class="about-main_portrait">
          {portrait ? (
            <Img src={portrait} alt="" />
          ) : (
            <div class="about-main_portrait_placeholder" aria-hidden="true" />
          )}
        </div>
        {(name || role) && (
          <div class="about-main_name-row">
            {name && (
              <Heading tag="h2" variant="h2" data-reveal="title-chars">
                {name}
              </Heading>
            )}
            {role && (
              <Paragraph variant="large" data-reveal="scroll-lines">
                {role}
              </Paragraph>
            )}
          </div>
        )}
      </div>

      <div class="about-main_rows">
        {bio.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Bio</p>
            <div class="about-main_row_content">
              {bio.map((paragraph) => (
                <Paragraph variant="main" data-reveal="scroll-lines">
                  {paragraph}
                </Paragraph>
              ))}
            </div>
          </div>
        )}
        {services.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Services</p>
            <ul class="about-main_list">
              {services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
        )}
        {tools.length > 0 && (
          <div class="about-main_row">
            <p class="about-main_row_label text-style-small">Tools I use</p>
            <ul class="about-main_tools">
              {tools.map((tool) => (
                <li class="about-main_tool">
                  <span class="about-main_tool_mark" aria-hidden="true" />
                  <span class="text-style-small">{tool}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .about-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      width: 100%;
    }

    .about-main_profile {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--space-6);
    }

    .about-main_portrait {
      flex: 1 1 20rem;
      max-width: 30rem;
      aspect-ratio: 5 / 4;
      border-radius: var(--radius-main);
      overflow: clip;
    }

    .about-main_portrait_placeholder {
      width: 100%;
      height: 100%;
      background-color: var(--background-skeleton);
    }

    .about-main_name-row {
      flex: 1 1 16rem;
    }

    .about-main_rows {
      display: flex;
      flex-direction: column;
    }

    .about-main_row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-6);
      padding-block: var(--space-6);
      border-top: var(--border-width) solid var(--border);
    }

    .about-main_row_label {
      flex: 0 0 10rem;
      font-weight: var(--primary-medium);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .about-main_row_content {
      flex: 1 1 30rem;
      max-width: 48rem;
      display: flex;
      flex-direction: column;
    }

    .about-main_list {
      flex: 1 1 30rem;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      list-style: none;
    }

    .about-main_tools {
      flex: 1 1 30rem;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      list-style: none;
    }

    .about-main_tool {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      width: 4rem;
      text-align: center;
    }

    .about-main_tool_mark {
      display: block;
      width: 3.5rem;
      height: 3.5rem;
      background-color: var(--background-skeleton);
      border-radius: var(--radius-small);
    }
  }
</style>
