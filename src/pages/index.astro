---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Form from "@/components/Form/Form.astro";
import Input from "@/components/Form/Input.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import ContentHeroMain from "@/components/Content/ContentHeroMain.astro";
import ContentHeroField from "@/components/Content/ContentHeroField.astro";
import ContentAboutMain from "@/components/Content/ContentAboutMain.astro";
import ProjectCard from "@/components/Item/ProjectCard.astro";
import { CONTACT_FORM_ENDPOINT } from "@/consts.ts";
import aronPortrait from "@/assets/photos/aron-portrait.jpg";
import figmaIcon from "@/assets/icons/tools/figma.svg";
import webflowIcon from "@/assets/icons/tools/webflow.svg";
import claudeCodeIcon from "@/assets/icons/tools/claude-code.svg";
import photoshopIcon from "@/assets/icons/tools/photoshop.svg";
import illustratorIcon from "@/assets/icons/tools/illustrator.svg";
import afterEffectsIcon from "@/assets/icons/tools/after-effects.svg";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <Section
    id="home"
    class="hero-stack_section"
    data-nav-theme="light"
    theme="light"
    paddingTop="even"
    fullHeight
    containerClass="flex-grow container-nav-safe"
  >
    <ContentHeroField slot="background" />
    <ContentHeroMain
      introLead="My name is"
      name="Aron Fridvalszky"
      introTrail="and"
      headline="I design things"
      subheadline="but mostly digital products"
      stats={[
        { label: "Location", value: "Budapest" },
        { label: "Focus", value: "Web Design, Product Design, Low Code" },
      ]}
    />
    <div
      class="section-stack_darken"
      id="hero-darken"
      data-darken-scope="self"
      aria-hidden="true"
      slot="overlay"
    />
  </Section>

  <Section
    id="work"
    data-nav-theme="dark"
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    gap="7"
    containerClass="container-nav-safe"
  >
    <Heading
      tag="h2"
      variant="h2"
      class="text-transform-uppercase"
      data-reveal="title-chars">Work</Heading
    >
    <div class="flex-vertical-nowrap gap-5 width-full">
      {
        projects.map(({ id, data }) => (
          <ProjectCard
            heading={data.heading}
            client={data.client}
            period={data.period}
            tags={data.tags}
            tint={data.tint}
            image={data.cardImage}
            status={data.status}
            href={data.href ?? `/work/${id}`}
          />
        ))
      }
    </div>
    <div
      class="section-stack_darken"
      id="work-darken"
      data-darken-scope="tail"
      aria-hidden="true"
      slot="overlay"
    />
  </Section>

  <Section
    id="about"
    data-nav-theme="light"
    theme="light"
    paddingTop="large"
    paddingBottom="large"
    gap="7"
    containerClass="container-nav-safe"
    class="background-3"
  >
    <Heading
      tag="h2"
      variant="h2"
      class="text-transform-uppercase"
      data-reveal="title-chars">About</Heading
    >
    <ContentAboutMain
      portrait={aronPortrait}
      name="Aron Fridvalszky"
      role="Product Designer"
      bio={[
        "I'm a product designer based in Budapest with a strong product design focus, working across UI/UX, design systems, and web design. I care about the small details that make a product feel considered — from the first click to the last pixel.",
        "Over the past several years I've worked with startups, agencies, and product teams. I use AI tools daily in my own workflow, and bring that same product thinking to every project I take on.",
      ]}
      services={[
        "UI/UX Design",
        "Product Strategy",
        "Design Systems",
        "Branding & Identity",
        "Motion Design",
        "Web Design & Low Code",
      ]}
      tools={[
        { name: "Figma", icon: figmaIcon },
        { name: "Webflow", icon: webflowIcon },
        { name: "Claude Code", icon: claudeCodeIcon },
        { name: "Photoshop", icon: photoshopIcon },
        { name: "Illustrator", icon: illustratorIcon },
        { name: "After Effects", icon: afterEffectsIcon },
      ]}
    />
  </Section>

  <Section
    id="contact"
    data-nav-theme="light"
    theme="light"
    paddingTop="large"
    paddingBottom="large"
    gap="7"
    containerClass="container-nav-safe"
    class="background-3"
  >
    <Heading
      tag="h2"
      variant="h2"
      class="text-transform-uppercase"
      data-reveal="title-chars">Contact</Heading
    >
    <Form
      name="contact"
      action={CONTACT_FORM_ENDPOINT || undefined}
      successMessage="Thanks — I'll get back to you soon."
    >
      <Input variant="text" label="Name" required />
      <Input variant="email" label="Email" required />
      <Textarea
        label="Message"
        placeholder="Tell me about your project..."
        required
      />
      <ButtonWrapper marginTop="3">
        <Button type="submit" class="radius-round">Send</Button>
      </ButtonWrapper>
    </Form>
  </Section>
</Layout>

<style is:global>
  @layer components {
    /* The hero is exactly one viewport tall, which is what makes this work
       cleanly: it stays pinned at the top for its own natural scroll range
       (no extra scroll distance added anywhere), and Work — a plain,
       normally-flowing section straight after it in the markup — climbs up
       and paints over it as it scrolls into view, purely from DOM order (a
       later element in the same stacking context paints on top of an
       earlier one by default; no z-index needed). No JS, no scroll-library
       sync to depend on — the browser's own layout engine does all of it.
       `is:global`, not scoped: this class is passed as a prop into
       `Section`'s own template, and Astro's style scoping only reaches
       elements written directly in *this* file, not ones a child component
       renders from a prop value. */
    .hero-stack_section {
      position: sticky;
      top: 0;
    }

    /* A darkening overlay *inside* the outgoing section itself, via
       `Section`'s `overlay` slot — not a separate element after it. An
       earlier version used a dedicated one-viewport-tall sticky element
       between each pair of sections for this, which added a whole extra
       viewport of scroll distance nothing else used: since the *next*
       section can't start climbing over anything until that separate
       element's own sticky window has run its course, it read as a dead
       stretch of scrolling and a big, static gap before anything moved.
       Scoping the darken to the section's own scroll range instead means
       Work already starts climbing the moment the hero begins darkening —
       no added distance, no gap. */
    .section-stack_darken {
      background-color: #000;
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
